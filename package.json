{
  "name": "pc-tycoon-enhanced",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/android",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.production.config.ts",
    "android:sync": "npm run build && npm exec --workspace @pc-tycoon/android -- cap sync android",
    "android:build": "npm run android:sync && cd apps/android/android && ./gradlew --no-daemon assembleDebug",
    "android:verify": "python3 tools/verify_apk.py"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12",
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.8",
    "@capacitor/cli": "8.5.3"
  }
}
